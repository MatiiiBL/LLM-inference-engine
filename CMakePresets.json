{
  "version": 5,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MINILLM_BUILD_TESTS": "ON",
        "MINILLM_BUILD_BENCH": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug (no sanitizer)",
      "description": "-O0 -g. Use this one in a debugger.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MINILLM_SANITIZER": "none"
      }
    },
    {
      "name": "asan",
      "inherits": "base",
      "displayName": "ASan + UBSan",
      "description": "The default correctness build. -O2 -g with address and undefined sanitizers; UB aborts rather than warns.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MINILLM_SANITIZER": "address"
      }
    },
    {
      "name": "tsan",
      "inherits": "base",
      "displayName": "ThreadSanitizer",
      "description": "For the threaded kernels and the thread pool.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "MINILLM_SANITIZER": "thread"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "description": "-O3 -DNDEBUG. The only preset to quote numbers from.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MINILLM_SANITIZER": "none"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "asan", "configurePreset": "asan" },
    { "name": "tsan", "configurePreset": "tsan" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": { "outputOnFailure": true, "verbosity": "default" },
      "execution": { "noTestsAction": "error", "stopOnFailure": false }
    },
    { "name": "debug", "inherits": "test-base", "configurePreset": "debug" },
    { "name": "asan", "inherits": "test-base", "configurePreset": "asan" },
    { "name": "tsan", "inherits": "test-base", "configurePreset": "tsan" },
    { "name": "release", "inherits": "test-base", "configurePreset": "release" }
  ]
}
