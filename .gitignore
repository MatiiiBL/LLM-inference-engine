# Build trees (one per preset)
/build/
compile_commands.json

# Generated golden data — reproducible with `python oracle/generate.py`,
# far too large to commit.
/oracle/data/

# Downloaded checkpoints
/models/*
!/models/.gitkeep

# Python
__pycache__/
*.py[cod]
/.venv/
/oracle/.venv/

# Local tool config — the whole directory, so nothing in it can be
# committed by accident.
/.claude/

# Local-only: the workflow briefs and architecture notes are not shared.
# Untracked files never appear in a new worktree on their own, so working
# copies that need these get them symlinked in rather than from git.
docs/

# Editors / OS
.vscode/
.idea/
.cache/
.DS_Store
*.swp
